<Window x:Class="Gizatullina_BPI_24_01_L1part1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Работник"
        Height="520"
        Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8FB">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="worker"
                   FontSize="40"
                   FontWeight="Bold"
                   Foreground="Black"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>
        
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Фамилия:"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="SurnameTextBox"
                         Grid.Column="1"
                         Height="40"
                         FontSize="18"
                         Padding="8"
                         BorderBrush="#E8A7BD"
                         BorderThickness="2"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Оклад($):"
                           FontWeight="SemiBold"
                           FontSize="20"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="SalaryTextBox"
                         Grid.Column="1"
                         Height="40"
                         FontSize="18"
                         Padding="8"
                         BorderBrush="#E8A7BD"
                         BorderThickness="2"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Год поступления:"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="YearTextBox"
                         Grid.Column="1"
                         Height="40"
                         FontSize="18"
                         Padding="8"
                         BorderBrush="#E8A7BD"
                         BorderThickness="2"/>
            </Grid>

            <Button Grid.Row="3"
                    x:Name="CalculateButton"
                    Content="Рассчитать"
                    Width="220"
                    Height="48"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="Black"
                    Background="#E9F153"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    Click="CalculateButton_Click"
                    Margin="0,5,0,20"/>

            <Border Grid.Row="4"
                    x:Name="ResultBorder"
                    Background="#FFE8E4"
                    BorderBrush="#E8A7BD"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="20"
                    Visibility="Collapsed">

                <StackPanel>

                    <TextBlock Text="Результат"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="ResultTextBlock"
                               FontSize="18"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </Grid>
        <TextBlock Grid.Row="2"
                   Text="Гизатуллина БПИ-24-01 ЛР1 Вариант 2 "
                   FontSize="14"
                   Foreground="#999999"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>

    </Grid>

</Window>